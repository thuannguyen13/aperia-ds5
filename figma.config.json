{
  "codeConnect": {
    "parser": "react",
    "label": "React",
    "include": ["components/**/*.ts", "components/**/*.tsx"],
    "language": "jsx",
    "importPaths": {
      "components/**": "@/"
    },
    "paths": {
      "@/*": ["./*"]
    },
    "compilerOptions": {
      "types": ["@figma/code-connect/figma-types"]
    }
  }
}
