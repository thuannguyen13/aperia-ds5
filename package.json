{
  "name": "aperia-ds5",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./theme-provider": {
      "types": "./dist/theme-provider.d.ts",
      "import": "./dist/theme-provider.js"
    },
    "./base.css": "./styles/base.css",
    "./token.css": "./styles/token.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build:lib": "tsup",
    "build:tokens": "node style-dictionary.config.js",
    "prepare": "npm run build:lib",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "generate:icons": "node --env-file=.env.local scripts/generate-icon-code-connect.mjs",
    "publish:icons": "npx figma connect publish -f components/ui/icon/icons.figma.tsx --skip-validation --batch-size 100",
    "cc:publish": "npx figma connect publish --skip-validation --batch-size 100"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": ">=18",
    "react-dom": ">=18",
    "style-dictionary": "^5.4.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@figma/code-connect": "^1.4.3",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.4.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.2.1",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  }
}
